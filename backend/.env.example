# Salin file ini menjadi .env lalu isi nilainya
# copy .env.example .env

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Kredensial Jira Cloud (wajib untuk data real; kosongkan = mock data)
JIRA_BASE_URL=https://<workspace>.atlassian.net
JIRA_API_EMAIL=
JIRA_API_TOKEN=

# Cache hasil fetch Jira (detik)
CACHE_TTL_SECONDS=300

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:7005

# API key yang harus dikirim frontend (header x-api-key / query api_key)
# Harus sama dengan VITE_API_KEY di frontend/.env. Kosongkan = tanpa auth.
API_KEY=
