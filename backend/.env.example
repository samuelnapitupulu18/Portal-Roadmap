# Salin file ini menjadi .env lalu isi nilainya
# copy .env.example .env

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Kredensial Jira Cloud (wajib untuk data real; kosongkan = mock data)
JIRA_BASE_URL=https://<workspace>.atlassian.net
JIRA_API_EMAIL=
JIRA_API_TOKEN=

# Cache hasil fetch Jira (detik)
CACHE_TTL_SECONDS=300

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# IP yang boleh mengakses API (pisahkan dengan koma, mendukung CIDR)
ALLOWED_IP_WHITELIST=127.0.0.1,::1
