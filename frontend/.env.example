# Salin file ini menjadi .env lalu isi, kemudian jalankan ulang `npm run build`
# cp .env.example .env

# Alamat backend yang BISA DIAKSES DARI BROWSER PENGGUNA (bukan localhost server)
VITE_API_BASE_URL=http://localhost:3001

# API key untuk backend — harus sama dengan API_KEY di backend/.env
VITE_API_KEY=
